# ─── Veritabanı (Supabase PostgreSQL) ────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → "Connection string"
#
# DATABASE_URL  : Uygulama çalışma zamanı bağlantısı.
#   - Sunucusuz/edge dağıtımda "Transaction pooler" (port 6543) kullanın.
#   - Kalıcı Node sunucusunda "Session pooler" (port 5432) da olur (IPv4 uyumlu).
# DIRECT_URL    : Migration/seed için DOĞRUDAN bağlantı (port 5432).
#   - Transaction pooler DDL/advisory lock desteklemediğinden migration burada çalışır.
#
# Not: Uzak veritabanlarında sslmode=verify-full kullanın. Supabase Database
# Settings ekranından indirilen CA sertifikasını base64'e çevirip
# DB_SSL_CA_BASE64 olarak verin.

DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full"
DB_SSL_CA_BASE64="<base64-encoded-pem-certificate>"

# Fonksiyon örneği başına açılacak en fazla bağlantı (varsayılan: 3).
# Session pooler (5432) istemci sınırı düşüktür (pool_size: 15); sunucusuz
# dağıtımda 6543 kullanın ve bu değeri düşük tutun.
# DB_POOL_MAX="3"

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# `openssl rand -base64 32`
NEXTAUTH_SECRET="<random-base64-secret-at-least-32-characters>"
# Çoklu instance/self-hosted dağıtım için sabit olmalıdır.
# `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"

# ─── Kriptografi ─────────────────────────────────────────────────────────────
# Lisans anahtarı HMAC-SHA256 pepper değeri (min 32 karakter)
APP_PEPPER="<random-hmac-pepper-at-least-32-characters>"
# AES-256-GCM anahtarı (64 hex karakter = 32 byte)
# Sunucu SSH/sudo parolaları da bu anahtarla şifrelenir; değiştirilirse
# kayıtlı parolalar çözülemez ve yeniden girilmeleri gerekir.
ENCRYPTION_KEY="<64-hex-character-random-key>"

# ─── Sunucu Domain Kontrolü (SSH) — OPSİYONEL ────────────────────────────────
# Varsayılan olarak yalnız genel (public) IP'lere SSH bağlantısı kurulur; bu,
# panelin kendi iç ağına yönlendirilmesini (SSRF) engeller. Sunucularınız özel
# bir ağda ise (ör. kendi makinenizde self-host) bu korumayı kapatın:
# SSH_ALLOW_PRIVATE_TARGETS=1
#
# Bir adımın sunucuyu yoklamak için harcayabileceği süre (ms). Sunucusuz
# dağıtımda fonksiyon süre sınırının altında kalmalıdır. Varsayılan 40000 olup
# Vercel Hobby'nin 60 sn sınırına uyar; Pro/self-host'ta artırabilirsiniz.
# SERVER_DOMAIN_STEP_BUDGET_MS=40000

# ─── Upstash Redis (rate limit) — OPSİYONEL ──────────────────────────────────
# Tanımlanmazsa oran sınırlama ve giriş kilidi süreç içi belleğe düşer: tek
# instance dağıtımda yeterlidir, çok instance'lı dağıtımda sayaçlar instance
# başına ayrıştığı için etkin limit instance sayısıyla çarpılır. İkisi birlikte
# tanımlanmalıdır; yalnız biri verilirse env denetimi hata verir.
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Upstash QStash (webhook kuyruğu + cron) — OPSİYONEL ─────────────────────
# Tanımlanmazsa webhook outbox kayıtları CRON_SECRET ile korunan dahili uçtan
# doğrudan teslim edilir. QSTASH_TOKEN tanımlanırsa QStash istekleri imzalar;
# imza anahtarları da zorunlu hale gelir.
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="sig_current"
QSTASH_NEXT_SIGNING_KEY="sig_next"
# Cron endpoint'leri için koruma anahtarı — QStash imzası yoksa tek doğrulama
# yöntemi budur, üretimde her zaman zorunludur.
CRON_SECRET="min-32-char-cron-secret-value"

# ─── E-posta (/lib/email soyutlaması) — OPSİYONEL ────────────────────────────
# EMAIL_DRIVER tanımlanmazsa e-posta gönderimi devre dışıdır: 2FA kodları ve
# ekip davetleri gönderilemez. Tanımlanırsa aşağıdaki alanların tamamı zorunludur.
# Sürücü: "smtp" (Nodemailer) veya "resend"
EMAIL_DRIVER="smtp"
EMAIL_FROM="Operasyon Merkezi <no-reply@example.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ─── GitHub Entegrasyonu (opsiyonel) ─────────────────────────────────────────
# Tanımlanırsa Ayarlar sayfasında "GitHub ile Bağlan" (OAuth) butonu görünür.
# Tanımlanmazsa yalnızca Personal Access Token ile bağlanılır — entegrasyon
# yine tam çalışır.
#
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: <APP_URL>/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Ops Center kaynak reposunun ortak sürümünü GitHub'dan okumak için opsiyonel,
# salt-okunur fine-grained token. Boşsa Ayarlar'daki GitHub bağlantısı kullanılır.
APP_GITHUB_TOKEN=""
# Vercel/GitHub build metadata'sı yoksa uygulamanın kaynak reposunu belirtin.
APP_GITHUB_REPOSITORY="tbsagdic/ops-center"

# ─── Uygulama ────────────────────────────────────────────────────────────────
# Panelin herkese açık taban URL'i (webhook/cron callback'leri için)
APP_URL="http://localhost:3000"
# GitHub sürümünün major/minor tabanı package.json "version" alanından okunur ve
# build sırasında sabitlenir; burada tanımlamak gerekmez.
DEPLOY_HOOK_URL=""

# Ops politikası tanımlandıysa terminal kayıtlar batch halinde cron ile silinir.
# Boş bırakılırsa yalnız kesin olarak süresi dolmuş Session/OTP kayıtları temizlenir.
WEBHOOK_RETENTION_DAYS=""
AUDIT_RETENTION_DAYS=""
LICENSE_EVENT_RETENTION_DAYS=""

# ─── Seed (yalnız ilk kurulum) ───────────────────────────────────────────────
# Varsayılan değer yoktur. Parola en az 16 karakter; büyük/küçük harf, sayı ve
# sembol içermelidir. Seed parolayı loglamaz ve ilk girişte değişimi zorunlu kılar.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="<strong-one-time-bootstrap-password>"
